{
  "API_URL": "http://127.0.0.1:1234/v1",
  "API_KEY": "lm-studio",
  "MODEL_NAME": "local-model",
  "TEMPERATURE": 0.4,
  "MAX_TOKENS": 1000,
  "ASSISTANT_MODE": "companion",
  "HISTORY_TAIL": 40,
  "PLUGINS_ENABLED": true,
  "PLUGINS": {
    "attachments": true,
    "persona": true,
    "notes": true,
    "screen": true,
    "phone_media": true,
    "pc_control": true,
    "rag": true,
    "voice": true,
    "browser_search": true,
    "auto_messages": true,
    "companion": true,
    "reminders": true,
    "memory": true,
    "deep_think": true,
    "files": true,
    "character_log": true
  },
  "PLUGIN_SETTINGS": {
    "pc_control": {
      "enabled": true,
      "sandbox": true,
      "allow_process_close": false,
      "confirm_danger": true
    },
    "browser_search": {
      "enabled": true,
      "search_engine": "duckduckgo",
      "open_each_query": true,
      "browser": "default"
    },
    "voice": {
      "enabled": true,
      "listen_enabled": false,
      "wake_enabled": false,
      "speak_enabled": false
    },
    "memory": {
      "enabled": true,
      "history_tail": 40,
      "diary_days": 10,
      "max_inject": 10
    }
  },
  "query_parser": {
    "default_quantity": "one",
    "default_language": "auto"
  },
  "search": {
    "engines": ["duckduckgo", "bing_images", "wikipedia"],
    "max_candidates_per_engine": 10,
    "parallel": true,
    "timeout_seconds": 8,
    "cache_ttl_hours": 24,
    "cache_dir": "cache/search",
    "download_dir": "attachments",
    "max_file_size_mb": 20,
    "weights": {
      "title_match": 0.30,
      "url_relevance": 0.15,
      "modifier_match": 0.15,
      "filter_match": 0.15,
      "source_quality": 0.10,
      "resolution": 0.10,
      "recency": 0.05
    },
    "source_quality": {
      "wikipedia.org": 1.0,
      "github.com": 0.95,
      "stackoverflow.com": 0.95,
      "youtube.com": 0.8,
      "wikimedia.org": 0.9,
      "pinterest.com": 0.5
    }
  },
  "response_format": {
    "always_include_description": true,
    "always_include_source": true,
    "max_links": 5,
    "link_style": "block"
  },
  "ACTIVE_CHARACTER": "лисичка",
  "SYSTEM_PROMPT": "Ты живой ассистент. Характер, стиль и границы — только из карточки персонажа. Не сжимай ответ ради краткости, если персонаж или пользователь просят иначе."
}
